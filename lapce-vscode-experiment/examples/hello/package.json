{
  "name": "sandbox-hello",
  "publisher": "lapce-experiment",
  "version": "0.0.1",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": ["onCommand:sandbox.hello"],
  "contributes": {
    "commands": [{ "command": "sandbox.hello", "title": "Sandbox: Hello" }],
    "configuration": { "properties": {
      "sandbox.greeting": { "type": "string", "default": "Hello from the sandbox" }
    }}
  }
}
