{
 "add_action": {
  "prefix": "wp-action",
  "body": [
   "add_action('${1:init}', '${2:callback}'${3:, 10, 1});"
  ],
  "description": "WordPress action hook"
 },
 "add_filter": {
  "prefix": "wp-filter",
  "body": [
   "add_filter('${1:the_content}', '${2:callback}'${3:, 10, 1});"
  ],
  "description": "WordPress filter hook"
 },
 "Plugin header": {
  "prefix": "wp-plugin",
  "body": [
   "<?php",
   "/**",
   " * Plugin Name: ${1:My Plugin}",
   " * Description: ${2:Description}",
   " * Version: 1.0.0",
   " * Author: ${3:Author}",
   " * Text Domain: ${4:my-plugin}",
   " */",
   "",
   "if (!defined('ABSPATH')) {",
   "\texit;",
   "}",
   "",
   "$0"
  ],
  "description": "Plugin main file header"
 },
 "Custom post type": {
  "prefix": "wp-cpt",
  "body": [
   "add_action('init', function () {",
   "\tregister_post_type('${1:book}', [",
   "\t\t'label'  => __('${2:Books}', '${3:textdomain}'),",
   "\t\t'public' => true,",
   "\t\t'supports' => ['title', 'editor', 'thumbnail'],",
   "\t\t'show_in_rest' => true,",
   "\t]);",
   "});"
  ],
  "description": "register_post_type"
 },
 "WP_Query loop": {
  "prefix": "wp-query",
  "body": [
   "\\$query = new WP_Query([",
   "\t'post_type'      => '${1:post}',",
   "\t'posts_per_page' => ${2:10},",
   "]);",
   "",
   "if (\\$query->have_posts()) {",
   "\twhile (\\$query->have_posts()) {",
   "\t\t\\$query->the_post();",
   "\t\t$0",
   "\t}",
   "\twp_reset_postdata();",
   "}"
  ],
  "description": "WP_Query with the loop"
 },
 "Enqueue assets": {
  "prefix": "wp-enqueue",
  "body": [
   "add_action('wp_enqueue_scripts', function () {",
   "\twp_enqueue_style('${1:handle}', get_stylesheet_directory_uri() . '/${2:style.css}', [], '${3:1.0.0}');",
   "\twp_enqueue_script('${1:handle}', get_stylesheet_directory_uri() . '/${4:main.js}', [], '${3:1.0.0}', true);",
   "});"
  ],
  "description": "Enqueue style and script"
 },
 "Shortcode": {
  "prefix": "wp-shortcode",
  "body": [
   "add_shortcode('${1:name}', function (\\$atts = [], \\$content = null) {",
   "\t\\$atts = shortcode_atts(['${2:key}' => '${3:default}'], \\$atts);",
   "\tob_start();",
   "\t$0",
   "\treturn ob_get_clean();",
   "});"
  ],
  "description": "add_shortcode"
 },
 "REST route": {
  "prefix": "wp-rest",
  "body": [
   "add_action('rest_api_init', function () {",
   "\tregister_rest_route('${1:myplugin/v1}', '/${2:items}', [",
   "\t\t'methods'             => 'GET',",
   "\t\t'callback'            => function (WP_REST_Request \\$request) {",
   "\t\t\treturn rest_ensure_response([$0]);",
   "\t\t},",
   "\t\t'permission_callback' => '__return_true',",
   "\t]);",
   "});"
  ],
  "description": "register_rest_route"
 },
 "Escaped output": {
  "prefix": "wp-esc",
  "body": [
   "echo esc_html(${1:\\$value});"
  ],
  "description": "esc_html output"
 },
 "Nonce field": {
  "prefix": "wp-nonce",
  "body": [
   "wp_nonce_field('${1:action}', '${2:_wpnonce}');"
  ],
  "description": "wp_nonce_field"
 },
 "Translate": {
  "prefix": "wp-i18n",
  "body": [
   "__('${1:text}', '${2:textdomain}')"
  ],
  "description": "Translatable string"
 },
 "Register taxonomy": {
  "prefix": "wp-taxonomy",
  "body": [
   "add_action('init', function () {",
   "\tregister_taxonomy('${1:genre}', '${2:post}', [",
   "\t\t'label'        => __('${3:Genres}', '${4:text-domain}'),",
   "\t\t'public'       => true,",
   "\t\t'hierarchical' => true,",
   "\t\t'show_in_rest' => true,",
   "\t]);",
   "});"
  ],
  "description": "register_taxonomy on init"
 },
 "Metabox": {
  "prefix": "wp-metabox",
  "body": [
   "add_action('add_meta_boxes', function () {",
   "\tadd_meta_box('${1:my_box}', __('${2:Box title}', '${3:text-domain}'), function (WP_Post \\$post) {",
   "\t\twp_nonce_field('${1:my_box}', '${1:my_box}_nonce');",
   "\t\t\\$value = get_post_meta(\\$post->ID, '_${1:my_box}', true);",
   "\t\techo '<input type=\"text\" name=\"${1:my_box}\" value=\"' . esc_attr(\\$value) . '\" />';",
   "\t}, '${4:post}');",
   "});"
  ],
  "description": "add_meta_box with nonce and saved field"
 },
 "AJAX action": {
  "prefix": "wp-ajax",
  "body": [
   "add_action('wp_ajax_${1:my_action}', '${2:my_action_handler}');",
   "add_action('wp_ajax_nopriv_${1:my_action}', '${2:my_action_handler}');"
  ],
  "description": "wp_ajax_ hooks for logged-in and anonymous users"
 },
 "Nav menus": {
  "prefix": "wp-nav-menu",
  "body": [
   "add_action('after_setup_theme', function () {",
   "\tregister_nav_menus([",
   "\t\t'${1:primary}' => __('${2:Primary menu}', '${3:text-domain}'),",
   "\t]);",
   "});"
  ],
  "description": "register_nav_menus"
 },
 "Image size": {
  "prefix": "wp-image-size",
  "body": [
   "add_action('after_setup_theme', function () {",
   "\tadd_image_size('${1:card}', ${2:600}, ${3:400}, ${4:true});",
   "});"
  ],
  "description": "add_image_size"
 },
 "Remote GET": {
  "prefix": "wp-remote-get",
  "body": [
   "\\$response = wp_remote_get('${1:https://example.com/api}', ['timeout' => ${2:15}]);",
   "if (is_wp_error(\\$response)) {",
   "\t${3:return;}",
   "}",
   "\\$data = json_decode(wp_remote_retrieve_body(\\$response), true);",
   "$0"
  ],
  "description": "wp_remote_get with error check"
 },
 "Widget": {
  "prefix": "wp-widget",
  "body": [
   "class ${1:My}_Widget extends WP_Widget {",
   "\tpublic function __construct() {",
   "\t\tparent::__construct('${2:my_widget}', __('${3:My Widget}', '${4:text-domain}'));",
   "\t}",
   "",
   "\tpublic function widget(\\$args, \\$instance) {",
   "\t\techo \\$args['before_widget'];",
   "\t\t$0",
   "\t\techo \\$args['after_widget'];",
   "\t}",
   "",
   "\tpublic function form(\\$instance) {",
   "\t}",
   "",
   "\tpublic function update(\\$new_instance, \\$old_instance) {",
   "\t\treturn \\$new_instance;",
   "\t}",
   "}",
   "add_action('widgets_init', fn () => register_widget(${1:My}_Widget::class));"
  ],
  "description": "WP_Widget skeleton"
 },
 "Cron event": {
  "prefix": "wp-cron",
  "body": [
   "add_action('${1:my_cron}', '${2:my_cron_callback}');",
   "if (!wp_next_scheduled('${1:my_cron}')) {",
   "\twp_schedule_event(time(), '${3:hourly}', '${1:my_cron}');",
   "}"
  ],
  "description": "schedule a cron event"
 }
,
 "Transient cache": {
  "prefix": "wp-transient",
  "body": [
   "\\$${1:value} = get_transient('${2:key}');",
   "if (false === \\$${1:value}) {",
   "\t\\$${1:value} = ${3:expensive_query()};",
   "\tset_transient('${2:key}', \\$${1:value}, ${4:HOUR_IN_SECONDS});",
   "}"
  ],
  "description": "Transient get-or-set cache pattern"
 },
 "Option value": {
  "prefix": "wp-option",
  "body": [
   "\\$${1:value} = get_option('${2:option_name}', ${3:default});"
  ],
  "description": "Read an option with a default"
 },
 "Settings API": {
  "prefix": "wp-settings",
  "body": [
   "add_action('admin_init', function () {",
   "\tregister_setting('${1:my_group}', '${2:my_option}');",
   "\tadd_settings_section('${3:my_section}', '${4:Section title}', '__return_null', '${5:my_page}');",
   "\tadd_settings_field('${2:my_option}', '${6:Field label}', function () {",
   "\t\t\\$${7:value} = get_option('${2:my_option}');",
   "\t\techo '<input name=\"${2:my_option}\" value=\"' . esc_attr(\\$${7:value}) . '\">';",
   "\t}, '${5:my_page}', '${3:my_section}');",
   "});"
  ],
  "description": "Settings API: setting, section and field"
 },
 "Register block": {
  "prefix": "wp-block",
  "body": [
   "add_action('init', function () {",
   "\tregister_block_type(__DIR__ . '/${1:build}');",
   "});"
  ],
  "description": "Register a block from its block.json directory"
 },
 "Customizer section": {
  "prefix": "wp-customizer",
  "body": [
   "add_action('customize_register', function (\\\\WP_Customize_Manager \\$wp_customize) {",
   "\t\\$wp_customize->add_section('${1:my_section}', [",
   "\t\t'title' => __('${2:Section}', '${3:text-domain}'),",
   "\t]);",
   "\t\\$wp_customize->add_setting('${4:my_setting}', [",
   "\t\t'default' => '${5:value}',",
   "\t\t'sanitize_callback' => '${6:sanitize_text_field}',",
   "\t]);",
   "\t\\$wp_customize->add_control('${4:my_setting}', [",
   "\t\t'label' => __('${7:Label}', '${3:text-domain}'),",
   "\t\t'section' => '${1:my_section}',",
   "\t\t'type' => '${8:text}',",
   "\t]);",
   "});"
  ],
  "description": "Customizer section, setting and control"
 },
 "wpdb prepare": {
  "prefix": "wp-prepare",
  "body": [
   "\\$${1:rows} = \\$wpdb->get_results(",
   "\t\\$wpdb->prepare(",
   "\t\t\"SELECT * FROM {\\$wpdb->prefix}${2:table} WHERE ${3:status} = %s\",",
   "\t\t${4:'publish'}",
   "\t)",
   ");"
  ],
  "description": "wpdb prepared SELECT"
 },
 "Admin menu page": {
  "prefix": "wp-admin-page",
  "body": [
   "add_action('admin_menu', function () {",
   "\tadd_menu_page('${1:Page title}', '${2:Menu title}', '${3:manage_options}', '${4:my-slug}', function () {",
   "\t\techo '<div class=\"wrap\"><h1>' . esc_html__('${1:Page title}', '${5:text-domain}') . '</h1></div>';",
   "\t}, '${6:dashicons-admin-generic}', ${7:80});",
   "});"
  ],
  "description": "add_menu_page with a render callback"
 },
 "Pagination links": {
  "prefix": "wp-pagination",
  "body": [
   "echo paginate_links([",
   "\t'total' => \\$${1:query}->max_num_pages,",
   "\t'current' => max(1, get_query_var('${2:paged}')),",
   "]);"
  ],
  "description": "paginate_links for a WP_Query"
 },
 "Localize script": {
  "prefix": "wp-localize",
  "body": [
   "wp_localize_script('${1:handle}', '${2:myData}', [",
   "\t'ajaxUrl' => admin_url('admin-ajax.php'),",
   "\t'nonce' => wp_create_nonce('${3:my_action}'),",
   "]);"
  ],
  "description": "Pass PHP data to an enqueued script"
 }
}
