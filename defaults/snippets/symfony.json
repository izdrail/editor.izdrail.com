 "Constraint validator": {
  "prefix": "sf-constraint-validator",
  "body": [
   "<?php",
   "",
   "namespace App\\\\Validator;",
   "",
   "use Symfony\\\\Component\\\\Validator\\\\Constraint;",
   "use Symfony\\\\Component\\\\Validator\\\\ConstraintValidator;",
   "",
   "class ${1:ContainsAlphanumeric}Validator extends ConstraintValidator",
   "{",
   "\tpublic function validate(mixed \\$value, Constraint \\$constraint): void",
   "\t{",
   "\t\tif (null === \\$value || '' === \\$value) {",
   "\t\t\treturn;",
   "\t\t}",
   "",
   "\t\t\\$this->context->buildViolation(\\$constraint->message)",
   "\t\t\t->setParameter('{{ value }}', \\$value)",
   "\t\t\t->addViolation();",
   "\t}",
   "}"
  ],
  "description": "Validator for a custom constraint"
